        "%%writefile sistema.py\n",
        "def adicionar_item(carrinho, nome, preco, quantidade):\n",
        "  \"\"\"Adiciona um item ao carrinho e retorna o carrinho atualizado.\"\"\"\n",
        "  item = {\"nome\": nome, \"preco\": preco, \"quantidade\": quantidade}\n",
        "  carrinho.append(item)\n",
        "  return carrinho\n",
        "\n",
        "def calcular_total(carrinho):\n",
        "  \"\"\"Retorna o valor total do carrinho (soma de preco * quantidade).\"\"\"\n",
        "  total = 0\n",
        "  for item in carrinho:\n",
        "    total += item[\"preco\"] * item[\"quantidade\"]\n",
        "  return round(total, 2)\n",
        "\n",
        "def tem_frete_gratis(valor_total):\n",
        "  \"\"\"Retorna True se o valor total for >= 150.00.\"\"\"\n",
        "  return valor_total >= 150.00"
      ]
