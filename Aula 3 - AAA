        "%%writefile test_sistema.py\n",
        "from sistema import adicionar_item, calcular_total, tem_frete_gratis\n",
        "def test_adicionar_item_adiciona_ao_carrinho():\n",
        "# Arrange (Organizar dados, iniciar variáveis, ...)\n",
        "  carrinho = []\n",
        "# Act (chamada à função a ser testada)\n",
