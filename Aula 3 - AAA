        "  assert len(carrinho) == 1, \"O carrinho deve ter exatamente 1 item após a inserção\"\n",
        "  assert carrinho[0][\"nome\"] == 'Caneca'\n",
        "\n",
        "def testar_adicionar_itens_existentes():\n",
        "  carrinho = []\n",
        "\n",
        "  item1 = adicionar_item(carrinho, 'mouse',50.0,1)\n",
        "  item2 = adicionar_item(carrinho, 'teclado', 80.0,1)\n",
        "\n",
        "  assert len(carrinho) == 2\n",
        "\n",
        "def test_adicionar_item_com_quantidade_zero():\n",
        "\n",
        "  carrinho = []\n",
        "  resultado = adicionar_item(carrinho, \"Brinde\",10.0,0)\n",
        "  assert resultado[0][\"quantidade\"] == 0,\\\n",
        "    \"A função aceita quantidade zero sem validar - vale discutir se deveria\"\n",
        "\n",
        "\n",
        "def test_calcular_total_carrinho_vazio_retornar_zero():\n",
        "  carrinho = []\n",
        "  total = calcular_total(carrinho)\n",
        "  assert total == 0\n",
        "\n",
        "def test_calcular_total_um_item():\n",
        "\n",
        "  carrinho = [{\"nome\": \"Livro\", \"preco\":40.0, \"quantidade\":1}]\n",
        "  total = calcular_total(carrinho)\n",
        "  assert total == 40.0, \"O total deve ser igual ao preço do único item\"\n",
        "\n",
        "\n",
        "def test_calcular_total_multiplos_itens():\n",
        "\n",
        "  carrinho = [\n",
        "    {\"nome\": \"Livro\", \"preco\":40.0, \"quantidade\":1},\n",
        "    {\"nome\": \"Caneca\", \"preco\":25.0, \"quantidade\":2}\n",
        "  ]\n",
        "  total = calcular_total(carrinho)\n",
        "  assert total == 90.0, \"25*2 + 40*1 deve ser 90.0\"\n",
        "\n",
        "\n",
        "def test_tem_frete_gratis_valor_abaixo_do_limite():\n",
        "\n",
        "  valor_total = 100.0\n",
        "  resultado = tem_frete_gratis(valor_total)\n",
        "  assert resultado is False, \"Valor abaixo de 150.00 não deve ter frete grátis\"\n",
        "\n",
        "def test_tem_frete_gratis_valor_acima_do_limite():\n",
        "\n",
        "  valor_total = 200.0\n",
        "  resultado = tem_frete_gratis(valor_total)\n",
        "  assert resultado is True, \"Valor acima de 150.00 deve ter frete grátis\"\n",
        "\n",
        "def test_tem_frete_gratis_valor_extamente_no_limite():\n",
        "\n",
        "  valor_total = 150.0\n",
        "  resultado = tem_frete_gratis(valor_total)\n",
        "  assert resultado is True, \\\n",
        "     \"Valor igual a 150.00 deve ter frete grátis, pois a regra usa >=(maior ou igual)\"\n",
        "\n"
